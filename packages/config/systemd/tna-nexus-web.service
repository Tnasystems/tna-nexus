[Unit]
Description=TNA-Nexus Web
After=network.target tna-nexus-api.service

[Service]
Type=simple
User=tna-nexus
Group=tna-nexus
WorkingDirectory=/var/www/tna-nexus/apps/web
EnvironmentFile=/var/www/tna-nexus/.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /var/www/tna-nexus/apps/web/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
