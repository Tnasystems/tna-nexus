{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowJs": false,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true
  },
  "include": [
    "src/**/*.ts",
    "../../packages/shared/src/**/*.ts"
  ]
}
