[Unit]
Description=TNA-Nexus API
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/tna-nexus
EnvironmentFile=/var/www/tna-nexus/.env
Environment=NODE_ENV=production
Environment=PORT=4000
ExecStart=/usr/bin/env pnpm --filter @tna-nexus/api start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
