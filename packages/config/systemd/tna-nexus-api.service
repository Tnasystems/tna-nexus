[Unit]
Description=TNA-Nexus API
After=network.target postgresql.service

[Service]
Type=simple
User=tna-nexus
Group=tna-nexus
WorkingDirectory=/var/www/tna-nexus
EnvironmentFile=/var/www/tna-nexus/.env
Environment=NODE_ENV=production
Environment=PORT=4000
ExecStart=/usr/bin/node /var/www/tna-nexus/apps/api/dist/apps/api/src/main.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
