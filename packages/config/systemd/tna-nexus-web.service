[Unit]
Description=TNA-Nexus Web
After=network.target tna-nexus-api.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/tna-nexus
EnvironmentFile=/var/www/tna-nexus/.env
ExecStart=/usr/bin/pnpm --filter @tna-nexus/web start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
