{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowJs": false,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/generated/**/*.js",
    "src/generated/**/*.js.map",
    "dist",
    "node_modules"
  ]
}
